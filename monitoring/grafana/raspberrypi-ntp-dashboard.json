        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.001 },
            { "color": "red", "value": 0.01 }
          ]},
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 6, "y": 1 },
