      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Client Table (sorted by requests)",
          "description": "Per-client snapshot: request count, drops, poll interval, and seconds since last request. Useful for spotting a client that's gone quiet (Last Seen climbing) or being rate-limited (Drops > 0).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "from(bucket: \"ntp\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"chrony_clients\" and r.host == \"raspberrypi-ntp\")\n  |> filter(fn: (r) => r._field == \"ntp_requests\" or r._field == \"ntp_drops\" or r._field == \"ntp_poll\" or r._field == \"last_rx\")\n  |> last()\n  |> group(columns: [\"client\", \"_field\"])\n  |> pivot(rowKey: [\"client\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"client\", \"ntp_requests\", \"ntp_drops\", \"ntp_poll\", \"last_rx\"])\n  |> sort(columns: [\"ntp_requests\"], desc: true)"
                      },
                      "labels": {
