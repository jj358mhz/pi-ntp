      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "NTP Requests per Day (by Client)",
          "description": "Daily NTP request count per client, derived from chrony's cumulative request counter. Uses increase() + difference() to correctly handle counter resets from chronyd restarts, so daily totals stay accurate even if the service restarts mid-day. Always shows the trailing five (5) complete days, regardless of the dashboard's time range picker.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "from(bucket: \"ntp\")\n  |> range(start: -5d)\n  |> filter(fn: (r) => r._measurement == \"chrony_clients\" and r._field == \"ntp_requests\" and r.host == \"raspberrypi-ntp\")\n  |> group(columns: [\"client\"])\n  |> increase()\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: false)\n  |> difference(nonNegative: true)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"client\"], valueColumn: \"_value\")\n  |> yield(name: \"daily_by_client\")\n"
                      },
                      "labels": {
                        "grafana.app/export-label": "influxdb-1",
                        "grafana.app/export-datasource-name": "influxdb"
                      }
                    },
                    "refId": "A",
