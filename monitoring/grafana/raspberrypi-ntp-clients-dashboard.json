      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "NTP Requests (by Client)",
          "description": "NTP request count per client, derived from chrony's cumulative request counter. Uses increase() + difference() to correctly handle counter resets from chronyd restarts, so totals stay accurate even if the service restarts mid-interval. Follows the dashboard's time range picker, with bucket size scaled automatically to the selected range (floored at 1 hour).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "// Never bucket finer than 1h, even when zoomed in — keeps sparse\n// pollers from collapsing into a 0/1 forest at narrow time ranges.\nminWindow = if int(v: v.windowPeriod) < int(v: 1h) then 1h else v.windowPeriod\n\nfrom(bucket: \"ntp\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) =>\n      r._measurement == \"chrony_clients\" and\n      r._field == \"ntp_requests\" and\n      r.host == \"raspberrypi-ntp\"\n  )\n  |> group(columns: [\"client\"])\n  |> increase()\n  |> aggregateWindow(every: minWindow, fn: last, createEmpty: false)\n  |> difference(nonNegative: true)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"client\"], valueColumn: \"_value\")\n  |> yield(name: \"requests_by_client\")"
                      },
                      "labels": {
                        "grafana.app/export-label": "influxdb-1",
                        "grafana.app/export-datasource-name": "influxdb"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "13.1.0",
            "spec": {
              "options": {
                "barRadius": 0.05,
                "barWidth": 0.95,
                "fullHighlight": false,
                "groupWidth": 0.8,
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "overflow": "ellipsis",
                  "placement": "right",
                  "showLegend": true
                },
                "orientation": "auto",
                "showValue": "auto",
                "stacking": "none",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                },
                "xField": "time",
                "xTickLabelRotation": 0,
                "xTickLabelSpacing": 100
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
