            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "efodpma1sz474d"
                      },
                      "spec": {
                        "query": "import \"strings\"\n\nfrom(bucket: \"ntp\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"chrony_clients\" and r._field == \"ntp_requests\" and r.host == \"raspberrypi-ntp\")\n  |> last()\n  |> map(fn: (r) => ({\n      _value: r._value,\n      _time: r._time,\n      _field: if strings.hasPrefix(v: r.client, prefix: \"192.168.1.\") then \"LAN-Core\"\n              else if strings.hasPrefix(v: r.client, prefix: \"192.168.10.\") then \"LAN-Corp\"\n              else if strings.hasPrefix(v: r.client, prefix: \"192.168.40.\") then \"LAN-IoT\"\n              else if strings.hasPrefix(v: r.client, prefix: \"192.168.30.\") then \"LAN-Security\"\n              else if strings.hasPrefix(v: r.client, prefix: \"192.168.53.\") then \"LAN-DNS\"\n              else if strings.hasPrefix(v: r.client, prefix: \"192.168.123.\") then \"LAN-NTP\"\n              else \"Other\"\n  }))\n  |> group(columns: [\"_field\"])\n  |> sum(column: \"_value\")"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
