# Utility Pi monitoring stack — deployed via Portainer
# Copy to .env and fill in real values. Do not commit .env.

# InfluxDB admin credentials (created on first init)
INFLUXDB_PASSWORD=changeme-strong-password
# InfluxDB admin token — used by Telegraf and other clients
# Generate: openssl rand -hex 32
INFLUXDB_TOKEN=changeme-generate-a-strong-token

# Grafana admin password
GRAFANA_PASSWORD=changeme-strong-password